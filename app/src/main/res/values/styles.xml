<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DynamicIsland" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF1C1C1E</item>
        <item name="android:statusBarColor">#FF1C1C1E</item>
        <item name="android:navigationBarColor">#FF1C1C1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">#FF0A84FF</item>
        <item name="android:colorPrimaryDark">#FF0A84FF</item>
        <item name="android:colorAccent">#FF30D158</item>
        <item name="android:buttonStyle">@style/Widget.DynamicIsland.Button</item>
    </style>

    <style name="Widget.DynamicIsland.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">16dp</item>
        <item name="android:radius">12dp</item>
    </style>
</resources>
